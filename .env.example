# Postgres connection string (Neon via Vercel Marketplace sets this automatically)
DATABASE_URL=

# Vercel Blob store token (set automatically when you connect a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=

# Your Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5-5

# The one password that unlocks the app
APP_PASSWORD=
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
